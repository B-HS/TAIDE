    "syntax": {
        "keyword": { "fg": "#8F08C4", "bold": false, "italic": false },
        "storage": { "fg": "#0000ff", "bold": false, "italic": false },
        "operator": { "fg": "#000000", "bold": false, "italic": false },
        "string": { "fg": "#a31515", "bold": false, "italic": false },
        "number": { "fg": "#098658", "bold": false, "italic": false },
        "regexp": { "fg": "#811f3f", "bold": false, "italic": false },
        "comment": { "fg": "#008000", "bold": false, "italic": false },
        "docComment": { "fg": "#008000", "bold": false, "italic": false },
