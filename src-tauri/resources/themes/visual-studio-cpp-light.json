        "invalid": { "fg": "#cd3131", "bold": false, "italic": false },
        "link": { "fg": "#a31515", "bold": false, "italic": false },
        "markdownHeading": { "fg": "#800000", "bold": true, "italic": false },
        "markdownEmphasis": { "fg": "#000000", "bold": false, "italic": false },
        "markdownStrong": { "fg": "#000080", "bold": true, "italic": false },
        "markdownCode": { "fg": "#800000", "bold": false, "italic": false },
        "markdownQuote": { "fg": "#000000", "bold": false, "italic": false },
        "markdownListMarker": { "fg": "#000000", "bold": false, "italic": false }
