        "parameter": { "fg": "#808080", "bold": false, "italic": false },
        "property": { "fg": "#000000", "bold": false, "italic": false },
        "type": { "fg": "#2B91AF", "bold": false, "italic": false },
        "class": { "fg": "#2B91AF", "bold": false, "italic": false },
        "interface": { "fg": "#2B91AF", "bold": false, "italic": false },
        "enum": { "fg": "#2B91AF", "bold": false, "italic": false },
        "constant": { "fg": "#0000ff", "bold": false, "italic": false },
        "namespace": { "fg": "#000000", "bold": false, "italic": false },
        "decorator": { "fg": "#74531F", "bold": false, "italic": false },
        "tag": { "fg": "#800000", "bold": false, "italic": false },
        "attribute": { "fg": "#ff0000", "bold": false, "italic": false },
