        "panel.inputBackground": "#fafbfc",
        "panel.inputBorder": "#e1e4e8",
        "panel.matchHighlight": "#735c0f",
        "editor.background": "#ffffff",
        "editor.foreground": "#24292e",
        "editor.lineHighlight": "#f6f8fa",
        "editor.cursor": "#044289",
        "editor.selection": "#0366d625",
        "editor.inactiveSelection": "#0366d611",
        "editor.lineNumber": "#1b1f234d",
        "editor.lineNumberActive": "#24292e",
        "editor.indentGuide": "#eff2f6",
        "editor.whitespace": "#d1d5da",
        "editor.bracketMatch": "#34d05800",
        "editor.findMatch": "#ffdf5d",
        "editor.findMatchHighlight": "#ffdf5d66",
        "editor.hoverBackground": "#ffffff",
        "editor.widgetBackground": "#f6f8fa",
        "editor.widgetBorder": "#e1e4e8",
        "editorGutter.addedBackground": "#28a745",
        "editorGutter.modifiedBackground": "#2188ff",
        "editorGutter.deletedBackground": "#d73a49",
        "editorBlame.foreground": "#6a737d",
        "editorBlame.background": "transparent",
        "diff.insertedBackground": "#34d05822",
        "diff.insertedLineBackground": "#34d05822",
        "diff.removedBackground": "#d73a4922",
        "diff.removedLineBackground": "#d73a4922",
        "diff.border": "#e1e4e8",
        "terminal.background": "#f6f8fa",
        "terminal.foreground": "#586069",
        "terminal.cursor": "#005cc5",
        "terminal.selection": "#ffffff",
        "terminal.commandBlockBorder": "#e1e4e8",
        "terminal.linkForeground": "#0366d6",
        "git.added": "#28a745",
        "git.modified": "#005cc5",
        "git.deleted": "#d73a49",
        "git.renamed": "#0366d6",
        "git.untracked": "#28a745",
        "git.conflicted": "#e36209",
        "git.staged": "#005cc5",
        "graph.lane1": "#0366d6",
        "graph.lane2": "#28a745",
        "graph.lane3": "#dbab09",
        "graph.lane4": "#5a32a3",
        "graph.lane5": "#1b7c83",
        "graph.lane6": "#d73a49",
        "graph.lane7": "#005cc5",
        "graph.lane8": "#22863a",
        "graph.lane9": "#b08800",
        "graph.lane10": "#5a32a3",
        "graph.lane11": "#3192aa",
        "graph.lane12": "#cb2431",
        "graph.refBranch": "#005cc5",
        "graph.refTag": "#dbab09",
        "graph.refHead": "#28a745",
        "statusIndicator.info": "#005cc5",
        "statusIndicator.warning": "#f9c513",
        "statusIndicator.error": "#cb2431",
        "statusIndicator.success": "#28a745",
        "menu.background": "#fafbfc",
        "menu.border": "#e1e4e8",
        "menu.itemHover": "#ebf0f4",
        "menu.separator": "#e1e4e8",
        "popover.background": "#f6f8fa",
        "popover.border": "#e1e4e8",
        "popover.itemHover": "#ebf0f4",
        "popover.separator": "#e1e4e8",
        "tooltip.background": "#f6f8fa",
        "tooltip.border": "#e1e4e8",
        "tooltip.itemHover": "#ebf0f4",
        "tooltip.separator": "#e1e4e8",
        "modal.background": "#f6f8fa",
        "modal.border": "#e1e4e8",
        "modal.itemHover": "#ebf0f4",
        "modal.separator": "#e1e4e8",
        "scrollbar.thumb": "#959da533",
        "scrollbar.thumbHover": "#959da544",
        "scrollbar.track": "transparent",
        "input.background": "#fafbfc",
        "input.foreground": "#2f363d",
        "input.border": "#e1e4e8",
        "input.placeholder": "#959da5",
        "input.focusBorder": "#2188ff",
        "button.background": "#e1e4e8",
        "button.foreground": "#1b1f23",
        "button.hoverBackground": "#d1d5da",
        "button.primaryBackground": "#159739",
        "button.primaryForeground": "#ffffff",
        "list.background": "#f6f8fa",
        "list.hoverBackground": "#ebf0f4",
        "list.activeBackground": "#e2e5e9",
        "list.foreground": "#586069"
    },
    "syntax": {
        "keyword": {
            "fg": "#d73a49",
            "bold": false,
            "italic": false
        },
        "storage": {
            "fg": "#d73a49",
            "bold": false,
            "italic": false
        },
        "operator": {
            "fg": "#d73a49",
            "bold": false,
            "italic": false
        },
        "string": {
            "fg": "#032f62",
            "bold": false,
            "italic": false
        },
        "number": {
            "fg": "#005cc5",
            "bold": false,
            "italic": false
        },
        "regexp": {
            "fg": "#032f62",
            "bold": false,
            "italic": false
        },
        "comment": {
            "fg": "#6a737d",
            "bold": false,
            "italic": false
        },
        "docComment": {
            "fg": "#6a737d",
            "bold": false,
            "italic": false
        },
        "function": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "method": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "variable": {
            "fg": "#24292e",
            "bold": false,
            "italic": false
        },
        "parameter": {
            "fg": "#e36209",
            "bold": false,
            "italic": false
        },
        "property": {
            "fg": "#24292e",
            "bold": false,
            "italic": false
        },
        "type": {
            "fg": "#005cc5",
            "bold": false,
            "italic": false
        },
        "class": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "interface": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "enum": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "constant": {
            "fg": "#005cc5",
            "bold": false,
            "italic": false
        },
        "namespace": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "decorator": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "tag": {
            "fg": "#22863a",
            "bold": false,
            "italic": false
        },
        "attribute": {
            "fg": "#6f42c1",
            "bold": false,
            "italic": false
        },
        "punctuation": {
            "fg": "#24292e",
            "bold": false,
            "italic": false
        },
        "invalid": {
            "fg": "#b31d28",
            "bold": false,
            "italic": true
        },
        "link": {
            "fg": "#032f62",
            "bold": false,
            "italic": false
        },
        "markdownHeading": {
            "fg": "#005cc5",
            "bold": true,
            "italic": false
        },
        "markdownEmphasis": {
            "fg": "#24292e",
            "bold": false,
            "italic": true
        },
        "markdownStrong": {
            "fg": "#24292e",
            "bold": true,
            "italic": false
        },
        "markdownCode": {
            "fg": "#005cc5",
            "bold": false,
            "italic": false
        },
        "markdownQuote": {
            "fg": "#22863a",
            "bold": false,
            "italic": false
        },
        "markdownListMarker": {
            "fg": "#24292e",
            "bold": false,
            "italic": false
        }
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment", "string.comment"],
            "settings": {
                "foreground": "#6a737d"
            }
        },
        {
            "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.other.enummember", "variable.language"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["entity", "entity.name"],
            "settings": {
                "foreground": "#6f42c1"
            }
        },
        {
            "scope": ["variable.parameter.function"],
            "settings": {
                "foreground": "#24292e"
            }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": {
                "foreground": "#22863a"
            }
        },
        {
            "scope": ["keyword"],
            "settings": {
                "foreground": "#d73a49"
            }
        },
        {
            "scope": ["storage", "storage.type"],
            "settings": {
                "foreground": "#d73a49"
            }
        },
        {
            "scope": ["storage.modifier.package", "storage.modifier.import", "storage.type.java"],
            "settings": {
                "foreground": "#24292e"
            }
        },
        {
            "scope": ["string", "punctuation.definition.string", "string punctuation.section.embedded source"],
            "settings": {
                "foreground": "#032f62"
            }
        },
        {
            "scope": ["support"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["meta.property-name"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["variable"],
            "settings": {
                "foreground": "#e36209"
            }
        },
        {
            "scope": ["variable.other"],
            "settings": {
                "foreground": "#24292e"
            }
        },
        {
            "scope": ["invalid.broken"],
            "settings": {
                "foreground": "#b31d28",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#b31d28",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["invalid.illegal"],
            "settings": {
                "foreground": "#b31d28",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["invalid.unimplemented"],
            "settings": {
                "foreground": "#b31d28",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["carriage-return"],
            "settings": {
                "foreground": "#fafbfc",
                "background": "#d73a49",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": ["message.error"],
            "settings": {
                "foreground": "#b31d28"
            }
        },
        {
            "scope": ["string variable"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["source.regexp", "string.regexp"],
            "settings": {
                "foreground": "#032f62"
            }
        },
        {
            "scope": [
                "string.regexp.character-class",
                "string.regexp constant.character.escape",
                "string.regexp source.ruby.embedded",
                "string.regexp string.regexp.arbitrary-repitition"
            ],
            "settings": {
                "foreground": "#032f62"
            }
        },
        {
            "scope": ["string.regexp constant.character.escape"],
            "settings": {
                "foreground": "#22863a",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["support.constant"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["support.variable"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["meta.module-reference"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["punctuation.definition.list.begin.markdown"],
            "settings": {
                "foreground": "#e36209"
            }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": {
                "foreground": "#005cc5",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.quote"],
            "settings": {
                "foreground": "#22863a"
            }
        },
        {
            "scope": ["markup.italic"],
            "settings": {
                "foreground": "#24292e",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": {
                "foreground": "#24292e",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.underline"],
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": {
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": ["markup.inline.raw"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
            "settings": {
                "foreground": "#b31d28",
                "background": "#ffeef0"
            }
        },
        {
            "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
            "settings": {
                "foreground": "#22863a",
                "background": "#f0fff4"
            }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": {
                "foreground": "#e36209",
                "background": "#ffebda"
            }
        },
        {
            "scope": ["markup.ignored", "markup.untracked"],
            "settings": {
                "foreground": "#f6f8fa",
                "background": "#005cc5"
            }
        },
        {
            "scope": ["meta.diff.range"],
            "settings": {
                "foreground": "#6f42c1",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["meta.diff.header"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": ["meta.separator"],
            "settings": {
                "foreground": "#005cc5",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["meta.output"],
            "settings": {
                "foreground": "#005cc5"
            }
        },
        {
            "scope": [
                "brackethighlighter.tag",
                "brackethighlighter.curly",
                "brackethighlighter.round",
                "brackethighlighter.square",
                "brackethighlighter.angle",
                "brackethighlighter.quote"
            ],
            "settings": {
                "foreground": "#586069"
            }
        },
        {
            "scope": ["brackethighlighter.unmatched"],
            "settings": {
                "foreground": "#b31d28"
            }
        },
        {
            "scope": ["constant.other.reference.link", "string.other.link"],
            "settings": {
                "foreground": "#032f62",
                "fontStyle": "underline"
            }
        }
    ],
    "terminal": {
        "black": "#24292e",
        "red": "#d73a49",
        "green": "#28a745",
        "yellow": "#dbab09",
        "blue": "#0366d6",
        "magenta": "#5a32a3",
        "cyan": "#1b7c83",
        "white": "#6a737d",
        "brightBlack": "#959da5",
        "brightRed": "#cb2431",
        "brightGreen": "#22863a",
        "brightYellow": "#b08800",
        "brightBlue": "#005cc5",
        "brightMagenta": "#5a32a3",
        "brightCyan": "#3192aa",
        "brightWhite": "#d1d5da",
        "background": "#f6f8fa",
        "foreground": "#586069",
        "cursor": "#005cc5",
        "selection": "#ffffff"
    },
    "author": "Primer",
    "license": "MIT",
    "source": "https://github.com/primer/github-vscode-theme"
}
