        "input.focusBorder": "#316dca",
        "button.background": "#3d444d",
        "button.foreground": "#adbac7",
        "button.hoverBackground": "#444c56",
        "button.primaryBackground": "#347d39",
        "button.primaryForeground": "#ffffff",
