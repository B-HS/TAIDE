    "syntax": {
        "keyword": {
            "fg": "#f97583",
            "bold": false,
            "italic": false
        },
        "storage": {
            "fg": "#f97583",
            "bold": false,
            "italic": false
        },
        "operator": {
            "fg": "#f97583",
            "bold": false,
            "italic": false
        },
        "string": {
            "fg": "#9ecbff",
            "bold": false,
            "italic": false
        },
        "number": {
            "fg": "#79b8ff",
            "bold": false,
            "italic": false
        },
        "regexp": {
            "fg": "#dbedff",
            "bold": false,
            "italic": false
        },
        "comment": {
            "fg": "#6a737d",
            "bold": false,
            "italic": false
        },
        "docComment": {
            "fg": "#6a737d",
            "bold": false,
            "italic": false
        },
        "function": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "method": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "variable": {
            "fg": "#e1e4e8",
            "bold": false,
            "italic": false
        },
        "parameter": {
            "fg": "#ffab70",
            "bold": false,
            "italic": false
        },
        "property": {
            "fg": "#e1e4e8",
            "bold": false,
            "italic": false
        },
        "type": {
            "fg": "#79b8ff",
            "bold": false,
            "italic": false
        },
        "class": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "interface": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "enum": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "constant": {
            "fg": "#79b8ff",
            "bold": false,
            "italic": false
        },
        "namespace": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "decorator": {
            "fg": "#b392f0",
            "bold": false,
            "italic": false
        },
        "tag": {
            "fg": "#85e89d",
