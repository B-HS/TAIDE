        "invalid": {
            "fg": "#fdaeb7",
            "bold": false,
            "italic": true
        },
        "link": {
            "fg": "#dbedff",
            "bold": false,
            "italic": false
        },
        "markdownHeading": {
            "fg": "#79b8ff",
            "bold": true,
            "italic": false
        },
        "markdownEmphasis": {
            "fg": "#e1e4e8",
            "bold": false,
            "italic": true
        },
        "markdownStrong": {
            "fg": "#e1e4e8",
            "bold": true,
            "italic": false
