        "white": "#e0def4",
        "brightBlack": "#908caa",
        "brightRed": "#eb6f92",
        "brightGreen": "#3e8fb0",
        "brightYellow": "#f6c177",
        "brightBlue": "#9ccfd8",
        "brightMagenta": "#c4a7e7",
        "brightCyan": "#ea9a97",
        "brightWhite": "#e0def4",
        "background": "#2a273f",
        "foreground": "#e0def4",
        "cursor": "#6e6a86",
        "selection": "#817c9c26"
