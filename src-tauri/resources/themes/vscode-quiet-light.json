            }
        },
        {
            "scope": ["markup.output", "markup.raw"],
            "settings": {
                "foreground": "#777777"
            }
        },
        {
            "scope": ["markup.prompt"],
            "settings": {
                "foreground": "#777777"
            }
        },
        {
            "scope": ["markup.heading"],
            "settings": {
                "foreground": "#AA3731"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": {
                "fontStyle": "bold"
