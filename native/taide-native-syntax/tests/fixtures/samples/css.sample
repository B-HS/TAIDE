@charset "utf-8";
@import url("theme.css") screen and (min-width: 100px);
/* comment 한글 😀 */
:root {
    --main-color: #06c;
    --spacing: calc(1rem + 2px);
}
html, body > main ~ aside + .sidebar[data-open="true" i]:not(.hidden)::before {
    color: var(--main-color, rgb(0 0 0 / 50%));
    background: url(image.png) no-repeat center / cover, linear-gradient(to right, #fff 0%, rgba(0, 0, 0, .5) 100%);
    font: italic bold 12px/1.5 "Helvetica Neue", sans-serif;
    content: "\201C quoted \201D";
    margin: -1.5em 0 !important;
    transition: opacity .3s ease-in-out;
}
@media screen and (max-width: 600px), print {
    #id.class:nth-child(2n + 1) { display: grid; grid-template-columns: repeat(3, 1fr); }
}
@font-face { font-family: "Custom"; src: url("font.woff2") format("woff2"); unicode-range: U+0000-00FF; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@supports (display: flex) and (not (display: grid)) { a:hover { color: red } }
.한글-class { width: 100%; }
