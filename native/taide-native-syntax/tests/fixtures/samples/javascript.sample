class Queue extends Array {
    static #instances = 0
    #items = []
    constructor(...items) {
        super(...items)
        Queue.#instances++
    }
    get size() {
        return this.#items.length
    }
    static async *drain(queue) {
        while (queue.size > 0) yield await queue.shift()
    }
}

