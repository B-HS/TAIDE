//! Crate docs with `code` and unicode: 한글 漢字 😀
#![allow(dead_code)]
use std::collections::HashMap;
use std::fmt::{self, Display};

/// Doc comment for a struct.
#[derive(Debug, Clone, PartialEq)]
pub struct Point<T: Copy> {
    pub x: T,
    pub y: T,
}

/* block comment /* nested block */ still comment */
pub enum Shape<'a> {
    Circle { radius: f64 },
    Label(&'a str),
    Empty,
}

impl<T: Copy + Display> fmt::Display for Point<T> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "({}, {})", self.x, self.y)
    }
}

macro_rules! square {
    ($value:expr) => {
        $value * $value
    };
}

const GREETING: &str = "안녕하세요, 世界! 😀 e\u{301} \n\t\"quoted\"";
static RAW: &str = r#"raw "string" with \ backslash"#;
const BYTES: &[u8] = b"bytes\x00";

async fn fetch(url: &str) -> Result<String, Box<dyn std::error::Error>> {
    let mut map: HashMap<&str, i32> = HashMap::new();
    map.insert("one", 1_000);
    let ch = 'x';
    let quote = '\'';
    let number = 0xFF_u8 as f32 + 1.5e-3;
    let closure = |a: i32, b: i32| -> i32 { a + b };
    if let Some(value) = map.get("one") {
        println!("{value:>5} {}", closure(*value, square!(2)));
    }
    loop {
        break;
    }
    match number {
        n if n > 1.0 => Ok(format!("{url}?n={n}")),
        _ => Err("שלום مرحبا rtl".into()),
    }
}

