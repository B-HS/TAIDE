import React, { Fragment } from 'react'

// 주석: 한글 漢字 😀
export function List({ items, onSelect }) {
    const total = items.reduce((sum, item) => sum + item.count, 0)
    if (!items.length) return <p className="empty">Nothing &lt;here&gt;</p>
    return (
        <Fragment>
            {/* comment */}
            <ul id="list" data-total={total}>
                {items.map((item) => (
                    <li key={item.id} onClick={() => onSelect(item)} style={{ fontWeight: item.count > 3 ? 'bold' : 'normal' }}>
                        {item.label} — {`${item.count} 개 😀`}
                    </li>
                ))}
            </ul>
            <Namespace.Item {...items[0]} disabled />
            <svg:rect width="10" />
        </Fragment>
    )
}
const regex = /<li>(.*?)<\/li>/g
export default List
