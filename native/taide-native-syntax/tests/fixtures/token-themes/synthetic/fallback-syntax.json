{
    "id": "fallback-syntax",
    "name": "Fallback Syntax",
    "type": "light",
    "colors": {
        "editor.background": "#ffffff",
        "editor.foreground": "#24292e",
        "editor.selection": "#0366d625"
    },
    "syntax": {
        "keyword": { "fg": "#d73a49", "bold": true },
        "storage": { "fg": "#d73a49" },
        "operator": { "fg": "#005cc5" },
        "string": { "fg": "#032f62" },
        "number": { "fg": "#005cc5" },
        "regexp": { "fg": "#032f62" },
        "comment": { "fg": "#6a737d", "italic": true },
        "docComment": { "fg": "#6a737d", "bold": true, "italic": true },
        "function": { "fg": "#6f42c1" },
        "method": { "fg": "#6f42c1" },
        "variable": { "fg": "#e36209" },
        "parameter": { "fg": "#24292e" },
        "property": { "fg": "#005cc5" },
        "type": { "fg": "#6f42c180" },
        "class": { "fg": "#6f42c1", "bold": true },
        "interface": { "fg": "#22863a" },
        "enum": { "fg": "#22863a", "italic": true },
        "constant": { "fg": "#005cc5" },
        "namespace": { "fg": "#6f42c1" },
        "decorator": { "fg": "#b31d28" },
        "tag": { "fg": "#22863a" },
        "attribute": { "fg": "#6f42c1" },
        "punctuation": { "fg": "#24292e" },
        "invalid": { "fg": "#B31D28", "italic": true },
        "link": { "fg": "#032f62" },
        "markdownHeading": { "fg": "#005cc5", "bold": true },
        "markdownEmphasis": { "fg": "#24292e", "italic": true },
        "markdownStrong": { "fg": "#24292e", "bold": true },
        "markdownCode": { "fg": "#005cc5" },
        "markdownQuote": { "fg": "#22863a" },
        "markdownListMarker": { "fg": "#e36209" }
    },
    "terminal": {}
}
