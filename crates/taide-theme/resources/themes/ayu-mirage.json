    "syntax": {
        "keyword": { "fg": "#ffa659", "bold": false, "italic": false },
        "storage": { "fg": "#ffa659", "bold": false, "italic": false },
        "operator": { "fg": "#f29e74", "bold": false, "italic": false },
        "string": { "fg": "#d5ff80", "bold": false, "italic": false },
        "number": { "fg": "#dfbfff", "bold": false, "italic": false },
        "regexp": { "fg": "#95e6cb", "bold": false, "italic": false },
        "comment": { "fg": "#6e7c8f", "bold": false, "italic": true },
        "docComment": { "fg": "#6e7c8f", "bold": false, "italic": true },
        "function": { "fg": "#ffcd66", "bold": false, "italic": false },
        "method": { "fg": "#ffcd66", "bold": false, "italic": false },
        "variable": { "fg": "#cccac2", "bold": false, "italic": false },
        "parameter": { "fg": "#dfbfff", "bold": false, "italic": false },
        "property": { "fg": "#cccac2", "bold": false, "italic": false },
        "type": { "fg": "#5ccfe6", "bold": false, "italic": false },
        "class": { "fg": "#73d0ff", "bold": false, "italic": false },
        "interface": { "fg": "#73d0ff", "bold": false, "italic": false },
        "enum": { "fg": "#73d0ff", "bold": false, "italic": false },
        "constant": { "fg": "#dfbfff", "bold": false, "italic": false },
        "namespace": { "fg": "#73d0ff", "bold": false, "italic": false },
        "decorator": { "fg": "#d9be98", "bold": false, "italic": false },
        "tag": { "fg": "#5ccfe6", "bold": false, "italic": false },
        "attribute": { "fg": "#ffcd66", "bold": false, "italic": false },
        "punctuation": { "fg": "#cccac2", "bold": false, "italic": false },
        "invalid": { "fg": "#ff6666", "bold": false, "italic": false },
        "link": { "fg": "#5ccfe6", "bold": false, "italic": false },
        "markdownHeading": { "fg": "#d5ff80", "bold": true, "italic": false },
        "markdownEmphasis": { "fg": "#f28779", "bold": false, "italic": true },
        "markdownStrong": { "fg": "#f28779", "bold": true, "italic": false },
        "markdownCode": { "fg": "#cccac2", "bold": false, "italic": false },
        "markdownQuote": { "fg": "#95e6cb", "bold": false, "italic": true },
        "markdownListMarker": { "fg": "#cccac2", "bold": false, "italic": false }
